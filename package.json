{
  "name": "la-piramide-perduta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Egyptian Noir Roguelike FPS — Vertical Slice",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dom": "vitest run --config vitest.config.dom.ts",
    "test:property": "vitest run tests/property",
    "test:e2e": "playwright test",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:boundaries && npm run verify:content && npm run test && npm run test:dom && npm run build",
    "benchmark:gen": "node scripts/benchmark-generation.mjs",
    "benchmark:replay": "node scripts/benchmark-replay.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "1.62.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "happy-dom": "^20.11.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/noto-sans-egyptian-hieroglyphs": "^5.3.0",
    "idb": "8.0.3",
    "three": "0.185.1",
    "zod": "4.4.3"
  }
}
